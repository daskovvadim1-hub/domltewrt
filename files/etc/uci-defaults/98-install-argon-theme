#!/bin/sh
# Install the verified Argon APKs bundled in the firmware and select Argon.
set -eu

THEME="/tmp/argon/luci-theme-argon-3.1.3-r1.apk"
RU="/tmp/argon/luci-i18n-argon-config-ru-3.1.3-r1.apk"

[ -s "$THEME" ] || exit 0
[ -s "$RU" ] || exit 1

# OpenWrt 25.12 uses apk-tools 3.x. Keep archives until both packages install.
apk add --allow-untrusted "$THEME" "$RU"

uci set luci.main.mediaurlbase='/luci-static/argon'
uci commit luci
rm -rf /tmp/argon

exit 0
